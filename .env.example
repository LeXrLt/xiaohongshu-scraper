# 小红书阅读器环境配置
# 复制为项目根目录的 .env，再按需修改。

# PostgreSQL（docker compose 默认使用这些值）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=xhs_reader
POSTGRES_PASSWORD=xhs_reader_dev_password
POSTGRES_DB=xhs_reader

# Python API
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000

# Next.js 浏览器请求 API 的地址
# 留空即可，前端会通过 Next.js /api 反代到 Python API
NEXT_PUBLIC_API_URL=

# 商户抽取 Agent（scripts/merchant.py）。密钥只放在本地 .env，不要提交到 Git。
# MERCHANT_AGENT_BASE_URL 可填写任意 OpenAI 兼容接口地址。
MERCHANT_AGENT_PROVIDER=openai
MERCHANT_AGENT_API_KEY=
MERCHANT_AGENT_BASE_URL=https://api.openai.com/v1
MERCHANT_AGENT_MODEL=gpt-4o-mini
MERCHANT_AGENT_TIMEOUT_S=60
MERCHANT_AGENT_RETRIES=2
MERCHANT_AGENT_BATCH_SIZE=5
MERCHANT_AGENT_MAX_NOTES=100
MERCHANT_EXTRACTOR_VERSION=v1
MERCHANT_PROMPT_VERSION=v1
