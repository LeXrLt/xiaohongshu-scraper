# 小红书阅读器环境配置
# 复制为项目根目录的 .env，再按需修改。

# PostgreSQL（docker compose 默认使用这些值）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=xhs_reader
POSTGRES_PASSWORD=xhs_reader_dev_password
POSTGRES_DB=xhs_reader

# Python API
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000

# API 永久密钥：用 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成
# 至少 32 字节；由管理员分发给可信 API 调用者，不提供匿名领取接口。
# 前端浏览器也会使用这个密钥，访问前端的用户可以取得它。
API_AUTH_KEY=
API_TOKEN_TTL_SECONDS=7200

# Next.js 浏览器请求 API 的地址
# 留空即可，前端会通过 Next.js /api 反代到 Python API
NEXT_PUBLIC_API_URL=

# Agent 通用配置（所有 LLM Agent 共享，如商户抽取、数据推送总结等）
# AGENT_BASE_URL 可填写任意 OpenAI 兼容接口地址。
AGENT_PROVIDER=openai
AGENT_API_KEY=
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-4o-mini
AGENT_TIMEOUT_S=60
AGENT_RETRIES=2

# 商户抽取 Agent 专有配置（scripts/merchant.py，如需覆盖通用配置可再设 MERCHANT_AGENT_*）
MERCHANT_AGENT_BATCH_SIZE=5
MERCHANT_AGENT_MAX_NOTES=100

# 推送 Agent 配置（scripts/push_agent.py）
LARK_WEBHOOK_URL=
LARK_WEBHOOK_SECRET=
PUSH_AGENT_CHANNEL=feishu
PUSH_AGENT_MAX_ITEMS=30

# Ticketmaster SG（可选；未设置时自动寻找 chromium/google-chrome）
# TICKETMASTER_CHROMIUM_PATH=/usr/bin/chromium
# TICKETMASTER_USER_AGENT=

# HKT 香港快達票（可选；默认使用项目独立 Profile 和公开 API）
# HKTICKETING_CHROMIUM_PATH=/usr/bin/chromium
# HKTICKETING_PROFILE_DIR=data/pw_profile_hkticketing
# HKTICKETING_API_BASE_URL=https://rest-sig.imaitix.com
