# 小红书阅读器环境配置
# 复制为项目根目录的 .env，再按需修改。

# PostgreSQL（docker compose 默认使用这些值）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=xhs_reader
POSTGRES_PASSWORD=xhs_reader_dev_password
POSTGRES_DB=xhs_reader

# Python API
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000

# Next.js 浏览器请求 API 的地址
# 留空即可，前端会通过 Next.js /api 反代到 Python API
NEXT_PUBLIC_API_URL=
